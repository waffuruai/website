# Google Analytics 4 measurement ID. Only production builds load GA, and only
# after the visitor consents. Set as the repository variable NEXT_PUBLIC_GA_ID
# for the production deploy; put it in .env.local to test locally.
NEXT_PUBLIC_GA_ID=

# Show unlaunched sections (site.launched) in this build: 1 shows them, 0
# hides them. Unset, dev and tests show them and production hides them. Set
# it in the shell or CI, not .env.local: postbuild does not read .env files.
NEXT_PUBLIC_SHOW_UNRELEASED=
