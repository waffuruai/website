{
  "name": "waffuru-website",
  "version": "1.0.0",
  "private": true,
  "description": "waffuru.ai: the marketing site and the release receiver that publishes every product's installer",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "pnpm run build && node scripts/assemble-site.mjs && wrangler dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "format": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,json,jsonc,css,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,jsx,ts,tsx,json,jsonc,css,md,mdx}\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "images": "node scripts/build-images.mjs",
    "site:check": "node scripts/check-site.mjs",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  }
}
